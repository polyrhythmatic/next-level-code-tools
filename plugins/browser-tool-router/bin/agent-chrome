#!/bin/bash
# agent-chrome: connect agents to the user's real, logged-in Chrome, and
# point Chrome tooling at Chrome for Testing instead of Google Chrome.app.
#
# The Playwright Extension token lives in the macOS Keychain and is passed
# only to the one playwright-cli process that attaches. It is never exported
# to shells, so harnesses that filter *TOKEN* variables (Codex) still work.
#
# Attach runs in the background: the user's frontmost app and active Chrome
# tab are put back after the extension connects. Chrome comes to the front
# only on `focus` / `handoff`, which agents use when the user must act.
#
# Each attached session is recorded under $STATE_DIR so `release` (and the
# SessionEnd / SubagentStop hooks of Claude Code or Codex, through `reap`) can close the
# tabs the agent opened. A plain `playwright-cli detach` only ungroups them.

set -euo pipefail

KEYCHAIN_SERVICE="playwright-extension-token"
PW_CACHE="$HOME/Library/Caches/ms-playwright"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/agent-chrome"
CHROME_APP="Google Chrome"
CHROME_BUNDLE="com.google.Chrome"
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
# The agent session that owns new sessions: Claude Code or Codex.
AGENT_SESSION_ID="${CLAUDE_CODE_SESSION_ID:-${CODEX_SESSION_ID:-}}"

usage() {
  cat <<'EOF'
Usage:
  agent-chrome attach [session]    attach playwright-cli to your real Chrome in
                                   the background (Playwright Extension; your
                                   logins, own tab group). Reuses a live session.
  agent-chrome focus [session]     bring the session's tab to the front; use
                                   only when the user must act on the page
  agent-chrome release [session]   close the session's tabs and detach
                                   (Chrome and the user's tabs stay open)
  agent-chrome handoff [session]   focus, then detach and KEEP the tabs, for
                                   when the user still needs the page
  agent-chrome list                show recorded sessions
  agent-chrome reap --owner <id> | --agent <id>
                                   release the sessions of one agent
                                   session or subagent (used by hooks)
  agent-chrome cft-path            print the Chrome for Testing binary path

The session defaults to "cc-<first 8 of the agent session id>-chrome", or
"${PLAYWRIGHT_CLI_SESSION}-chrome" when that is set. Parallel agents must
each pass their own session name.
Run commands with: playwright-cli -s=<session> <command>

cft-path: for tools without a config file, e.g.
  chrome-devtools start --isolated --executablePath "$(agent-chrome cft-path)"
EOF
}

die() {
  printf 'agent-chrome: %s\n' "$*" >&2
  exit 1
}

default_session() {
  if [ -n "${PLAYWRIGHT_CLI_SESSION:-}" ]; then
    printf '%s-chrome\n' "$PLAYWRIGHT_CLI_SESSION"
  elif [ -n "$AGENT_SESSION_ID" ]; then
    printf 'cc-%s-chrome\n' "${AGENT_SESSION_ID:0:8}"
  else
    printf 'default-chrome\n'
  fi
}

resolve_session() {
  local session="${1:-$(default_session)}"
  [[ "$session" =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid session name: $session"
  printf '%s\n' "$session"
}

is_attached() {
  playwright-cli list 2>/dev/null | grep -qxF -- "- $1:"
}

# playwright-cli keys sessions by workspace (nearest parent with .playwright/),
# so later commands must run from the directory where the session attached.
enter_session_dir() {
  local record="$STATE_DIR/sessions/$1" dir
  [ -f "$record" ] || return 0
  dir=$(sed -n 's/^cwd=//p' "$record" | tail -1)
  [ -n "$dir" ] && [ -d "$dir" ] && cd "$dir"
  return 0
}

front_bundle() {
  lsappinfo info -only bundleid "$(lsappinfo front 2>/dev/null)" 2>/dev/null \
    | sed -E 's/.*="?([^"]*)"?$/\1/'
}

chrome_running() {
  pgrep -xq "$CHROME_APP"
}

# Prints "<window id> <tab id>" of the tab the user has in view.
chrome_active_tab() {
  osascript 2>/dev/null <<OSA
with timeout of 3 seconds
  tell application "$CHROME_APP"
    if (count windows) is 0 then return ""
    return (id of front window as text) & " " & (id of active tab of front window as text)
  end tell
end timeout
OSA
}

chrome_select_tab() {
  osascript >/dev/null 2>&1 <<OSA
with timeout of 3 seconds
  tell application "$CHROME_APP"
    set w to window id $1
    repeat with i from 1 to (count tabs of w)
      if (id of tab i of w as text) is "$2" then
        set active tab index of w to i
        exit repeat
      end if
    end repeat
  end tell
end timeout
OSA
}

# The extension focuses Chrome and the new tab when it connects. Put back the
# tab the user had in view and the app the user was in.
restore_focus() {
  local prev_front="$1" prev_tab="$2"
  if [ -n "$prev_tab" ]; then
    # shellcheck disable=SC2086
    chrome_select_tab $prev_tab || true
  fi
  if [ -n "$prev_front" ] && [ "$prev_front" != "$CHROME_BUNDLE" ] \
    && [ "$(front_bundle || true)" = "$CHROME_BUNDLE" ]; then
    open -b "$prev_front" 2>/dev/null || true
  fi
}

# Runs beside the attach until killed: each time the extension pulls Chrome
# forward, send the user back to the app they were in. Cuts the flash to a
# fraction of a second instead of the full attach time.
watch_focus() {
  local prev_front="$1" _
  for _ in $(seq 1 400); do
    if [ "$(front_bundle || true)" = "$CHROME_BUNDLE" ]; then
      open -b "$prev_front" 2>/dev/null || true
    fi
    sleep 0.05
  done
}

cmd_attach() {
  local session
  session=$(resolve_session "${1:-}")
  command -v playwright-cli >/dev/null 2>&1 || die "playwright-cli is not installed"
  if is_attached "$session"; then
    printf 'Session: %s (already attached; reused)\n' "$session"
    return 0
  fi
  local token
  token=$(security find-generic-password -a "$USER" -s "$KEYCHAIN_SERVICE" -w 2>/dev/null) \
    || die "no token in Keychain (service: $KEYCHAIN_SERVICE). Create one in the Playwright Extension, then run:
  security add-generic-password -a \"\$USER\" -s $KEYCHAIN_SERVICE -w"

  local prev_front prev_tab=""
  prev_front=$(front_bundle || true)
  if chrome_running; then
    prev_tab=$(chrome_active_tab || true)
  fi

  # PLAYWRIGHT_MCP_EXECUTABLE_PATH makes playwright-cli call this script (not
  # the Chrome binary) with the connect URL; see the chrome-extension:// case
  # at the bottom, which opens it without activating Chrome.
  # --idle-timeout=0: an idle detach would orphan the tabs; `release` owns them.
  # The attach output echoes the extension connect URL, which carries the
  # token; redact it so it never lands in agent transcripts.
  local status=0 watcher=""
  if [ -n "$prev_front" ] && [ "$prev_front" != "$CHROME_BUNDLE" ]; then
    watch_focus "$prev_front" >/dev/null 2>&1 &
    watcher=$!
  fi
  PLAYWRIGHT_MCP_EXECUTABLE_PATH="$SELF" PLAYWRIGHT_MCP_EXTENSION_TOKEN="$token" \
    playwright-cli -s="$session" attach --extension=chrome --idle-timeout=0 2>&1 \
    | sed -E 's/token=[^&[:space:])]+/token=REDACTED/g' || status=$?
  # The attached tab is the extension's connect page, whose URL also carries
  # the token; navigate it away so later tab-list/snapshot output is clean.
  if [ "$status" -eq 0 ]; then
    playwright-cli -s="$session" goto about:blank >/dev/null 2>&1 || true
  fi
  if [ -n "$watcher" ]; then
    kill "$watcher" 2>/dev/null || true
    wait "$watcher" 2>/dev/null || true
  fi
  restore_focus "$prev_front" "$prev_tab"
  [ "$status" -eq 0 ] || return "$status"

  mkdir -p "$STATE_DIR/sessions"
  printf 'owner=%s\ncwd=%s\n' "${AGENT_SESSION_ID:--}" "$PWD" >"$STATE_DIR/sessions/$session"
  printf '\nSession: %s (background; run "agent-chrome release %s" when done)\n' "$session" "$session"
}

cmd_focus() {
  local session
  session=$(resolve_session "${1:-}")
  enter_session_dir "$session"
  is_attached "$session" || die "session $session is not attached"
  local index
  index=$(playwright-cli -s="$session" tab-list 2>/dev/null \
    | sed -nE 's/^- ([0-9]+): \(current\).*/\1/p' | head -1)
  playwright-cli -s="$session" tab-select "${index:-0}" >/dev/null 2>&1 || true
  open -a "$CHROME_APP"
}

cmd_release() {
  local session
  session=$(resolve_session "${1:-}")
  enter_session_dir "$session"
  if is_attached "$session"; then
    # Closing the last tab makes the extension drop the connection, which
    # ends the session; the detach below covers a session that survives.
    local _
    for _ in $(seq 1 50); do
      playwright-cli -s="$session" tab-close >/dev/null 2>&1 || break
      is_attached "$session" || break
    done
    playwright-cli -s="$session" detach >/dev/null 2>&1 || true
  fi
  rm -f "$STATE_DIR/sessions/$session"
  printf 'Released: %s\n' "$session"
}

cmd_handoff() {
  local session
  session=$(resolve_session "${1:-}")
  cmd_focus "$session"
  playwright-cli -s="$session" detach >/dev/null 2>&1 || true
  rm -f "$STATE_DIR/sessions/$session"
  printf 'Handed off: %s (tabs stay open for the user)\n' "$session"
}

cmd_list() {
  local record
  for record in "$STATE_DIR"/sessions/*; do
    [ -f "$record" ] || continue
    printf '%s\t%s\n' "$(basename "$record")" "$(tr '\n' ' ' <"$record")"
  done
}

cmd_reap() {
  local mode="${1:-}" id="${2:-}" record session
  [[ "$id" =~ ^[A-Za-z0-9._-]+$ ]] || die "reap needs --owner <id> or --agent <id>"
  case "$mode" in
    --owner)
      for record in "$STATE_DIR"/sessions/*; do
        [ -f "$record" ] || continue
        grep -qxF "owner=$id" "$record" || continue
        (cmd_release "$(basename "$record")") || true
      done
      ;;
    --agent)
      # Written by the browser-router-nudge hook: one session name per line.
      local map="$STATE_DIR/agents/$id"
      [ -f "$map" ] || return 0
      sort -u "$map" | while IFS= read -r session; do
        [ -f "$STATE_DIR/sessions/$session" ] || continue
        (cmd_release "$session") || true
      done
      rm -f "$map"
      ;;
    *) die "reap needs --owner <id> or --agent <id>" ;;
  esac
}

cmd_cft_path() {
  local app
  # Newest build wins: sort on the number in chromium-<build>/.
  app=$(find "$PW_CACHE" -maxdepth 3 -name "Google Chrome for Testing.app" -path "*/chromium-*" 2>/dev/null \
    | sed -E 's|.*/chromium-([0-9]+)/.*|\1	&|' | sort -n | tail -1 | cut -f2-)
  [ -n "$app" ] || die "Chrome for Testing not found; run: playwright-cli install-browser chrome-for-testing"
  printf '%s\n' "$app/Contents/MacOS/Google Chrome for Testing"
}

# Called by playwright-cli as the "browser executable" during attach: open the
# extension connect page in the running Chrome without bringing it forward.
for arg in "$@"; do
  case "$arg" in
    chrome-extension://*) exec open -g -a "$CHROME_APP" "$arg" ;;
  esac
done

case "${1:-}" in
  attach) shift; cmd_attach "$@" ;;
  focus) shift; cmd_focus "$@" ;;
  release) shift; cmd_release "$@" ;;
  handoff) shift; cmd_handoff "$@" ;;
  list) cmd_list ;;
  reap) shift; cmd_reap "$@" ;;
  cft-path) cmd_cft_path ;;
  -h|--help|help|"") usage ;;
  *) usage >&2; exit 1 ;;
esac
