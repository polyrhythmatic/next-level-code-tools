{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "\"${PLUGIN_ROOT}/hooks/link-agent-chrome.sh\"", "timeout": 10 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "\"${PLUGIN_ROOT}/hooks/browser-router-nudge.sh\"", "timeout": 10 } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "\"${PLUGIN_ROOT}/hooks/browser-session-cleanup.sh\"", "timeout": 3 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "\"${PLUGIN_ROOT}/hooks/browser-session-cleanup.sh\"", "timeout": 3 } ] }
    ]
  }
}
